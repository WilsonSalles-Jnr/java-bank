<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="287.0" prefWidth="250.0" spacing="5.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.boreal.javabank.controller.TransferController">
   <children>
      <VBox>
         <children>
            <Label fx:id="fromName" alignment="TOP_CENTER" prefWidth="250.0" text="NOME DO CLIENTE" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Label text="Conta de transferência" VBox.vgrow="ALWAYS" />
            <ChoiceBox fx:id="fromAccounts" prefWidth="250.0" VBox.vgrow="ALWAYS" />
            <Label fx:id="currentAmount" alignment="TOP_RIGHT" prefWidth="250.0" text="SALDO: R$ 100,00">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <Label text="Destinatário" />
      <ChoiceBox fx:id="destinatary" prefHeight="25.0" prefWidth="250.0" VBox.vgrow="ALWAYS" />
      <Label text="Conta" />
      <ChoiceBox fx:id="account" prefWidth="250.0" VBox.vgrow="ALWAYS" />
      <Label text="Valor" />
      <TextField fx:id="transferValue" />
      <Button mnemonicParsing="false" onAction="#handleTransfer" text="Transferir" />
      <Label fx:id="failedMessage" text="Label" textFill="RED" visible="false" />
   </children>
</VBox>
